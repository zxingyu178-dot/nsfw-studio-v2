    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "jsdom": "^30.1.2",
    "rollup": "^4.64.0",
    "typescript": "~5.6.2",
    "vite": "^5.4.8",
    "vitest": "^3.2.7"
  },
  "optionalDependencies": {
