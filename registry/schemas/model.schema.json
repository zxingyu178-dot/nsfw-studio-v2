{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nsfw-studio.local/schemas/model.schema.json",
  "title": "NSFW Studio Model Manifest",
  "description": "W4.1 Model Center 模型注册定义。物理文件不进入 Git，本 Manifest 只登记身份、版本、文件与 Hash。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "model_id", "version", "display_name", "family",
    "model_type", "format", "status", "files"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "model_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]*$",
      "minLength": 3,
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "display_name": {"type": "string", "minLength": 1, "maxLength": 200},
    "family": {"type": "string", "minLength": 1, "maxLength": 64},
    "model_type": {
      "type": "string",
      "enum": ["diffusion_model", "text_encoder", "vae", "lora", "checkpoint", "upscaler", "other"]
    },
    "format": {
      "type": "string",
      "enum": ["gguf", "safetensors", "pth", "ckpt", "other"]
    },
    "status": {
      "type": "string",
      "enum": ["released", "archived", "deprecated", "experimental"]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["filename", "folder", "required"],
        "properties": {
          "filename": {"type": "string", "minLength": 1, "maxLength": 255},
          "folder": {
            "type": "string",
            "enum": ["diffusion_models", "unet_gguf", "text_encoders", "vae", "loras", "checkpoints", "upscale_models", "other"]
          },
          "required": {"type": "boolean"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {
            "type": "string",
            "pattern": "^(unverified|[a-f0-9]{64})$"
          },
          "precision": {"type": "string", "maxLength": 32}
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model_id"],
        "properties": {
          "model_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$"},
          "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
          "required": {"type": "boolean"},
          "note": {"type": "string", "maxLength": 200}
        }
      }
    },
    "compatible_workflows": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
    },
    "notes": {"type": "string", "maxLength": 500},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"}
  }
}
